datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ClientType {
  ITALY
  EU
  EXTRA_EU
}

enum TaxRegime {
  FORFETTARIO
  ORDINARIO
  PRESTAZIONE_OCCASIONALE
}

enum InvoiceStatus {
  ISSUED
  PAID
  PARTIALLY_PAID
  CANCELLED
}

enum SenderType {
  LIBERO_PROFESSIONISTA
  DITTA_INDIVIDUALE
  SOCIETA
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  name          String
  passwordHash  String
  role          UserRole    @default(USER)
  
  businessName  String
  vatNumber     String
  taxCode       String
  address       String
  city          String
  zipCode       String
  country       String      @default("IT")
  province      String?
  taxRegime     TaxRegime   @default(FORFETTARIO)
  senderType    SenderType  @default(LIBERO_PROFESSIONISTA)

  sessionVersion   Int      @default(0)
  totpSecret       String?
  totpEnabled      Boolean  @default(false)
  totpBackupCodes  String[] @default([])

  zeroKnowledgeEnabled      Boolean   @default(false)
  zeroKnowledgeActivatedAt  DateTime?

  userKey          UserKey?
  accounts         Account[]
  sessions         Session[]
  authTokens       AuthToken[]
  clients          Client[]
  payments         Payment[]
  invoices         Invoice[]

  @@map("User")
}

model UserKey {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  argon2Salt  String
  wPwd        String
  wSys        String
  zeroKnowledgeMode Boolean @default(false)
  zkSalt      String?
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("UserKey")
}

model AuthToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@map("AuthToken")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@map("Account")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@map("Session")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("VerificationToken")
}

model Client {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name      String
  type      ClientType  @default(EXTRA_EU)
  vatNumber String?
  taxCode   String?
  sdiCode   String?
  address   String?
  city      String?
  zipCode   String?
  country   String?
  
  payments  Payment[]
  invoices  Invoice[]
  
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
  @@map("Client")
}

model Payment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id])
  invoiceId   String?
  invoice     Invoice?  @relation(fields: [invoiceId], references: [id])
  
  amount      Decimal
  currency    String
  originalAmount   Decimal?
  originalCurrency String?
  paidAt      DateTime
  description String
  
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([clientId])
  @@index([invoiceId])
  @@map("Payment")
}

model Invoice {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  number        Int
  year          Int
  date          DateTime
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id])
  subtotalAmount Decimal
  stampDutyAmount Decimal
  totalAmount   Decimal
  notes         String?
  status        InvoiceStatus @default(ISSUED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items         InvoiceItem[]
  payments      Payment[]

  @@index([userId])
  @@index([clientId])
  @@map("Invoice")
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  amount      Decimal

  @@map("InvoiceItem")
}
