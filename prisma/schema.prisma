datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ClientType {
  ITALY
  EU
  EXTRA_EU
}

enum TaxRegime {
  FORFETTARIO
  ORDINARIO
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

enum SenderType {
  LIBERO_PROFESSIONISTA
  DITTA_INDIVIDUALE
  SOCIETA
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  name          String
  passwordHash  String
  role          UserRole    @default(USER)
  
  businessName  String
  vatNumber     String
  taxCode       String
  address       String
  city          String
  zipCode       String
  country       String      @default("IT")
  province      String?
  taxRegime     TaxRegime   @default(FORFETTARIO)
  senderType    SenderType  @default(LIBERO_PROFESSIONISTA)

  // Sicurezza sessioni: incrementato a ogni cambio password (invalida i JWT precedenti).
  sessionVersion   Int      @default(0)
  // Autenticazione a due fattori (TOTP): secret cifrato, mai in chiaro nel DB.
  totpSecret       String?
  totpEnabled      Boolean  @default(false)
  totpBackupCodes  String[] @default([])

  clients       Client[]
  payments      Payment[]
  invoices      Invoice[]
  accounts      Account[]
  sessions      Session[]
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Client {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  type        ClientType  @default(EXTRA_EU)
  vatNumber   String?
  taxCode     String?
  sdiCode     String?     @default("XXXXXXX")
  address     String?
  city        String?
  zipCode     String?     @default("00000")
  country     String      @default("US")
  
  payments    Payment[]
  invoices    Invoice[]
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
}

model Payment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id])
  amount           Decimal   @db.Decimal(10, 2)
  currency         String    @default("EUR")
  originalAmount   Decimal?  @db.Decimal(10, 2)
  originalCurrency String?
  paidAt           DateTime
  description      String
  invoiceId        String?
  invoice          Invoice?  @relation(fields: [invoiceId], references: [id])
  
  createdAt   DateTime  @default(now())

  @@index([userId])
}

model Invoice {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  number            Int
  year              Int
  date              DateTime
  clientId          String
  client            Client        @relation(fields: [clientId], references: [id])
  payments          Payment[]
  items             InvoiceItem[]
  subtotalAmount    Decimal       @db.Decimal(10, 2)
  stampDutyAmount   Decimal       @default(0.00) @db.Decimal(10, 2)
  totalAmount       Decimal       @db.Decimal(10, 2)
  notes             String?
  status            InvoiceStatus @default(ISSUED)
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([userId, year, number])
  @@index([userId])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  amount      Decimal  @db.Decimal(10, 2)
}