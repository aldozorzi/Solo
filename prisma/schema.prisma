datasource db {
  provider  = "postgresql"
  // DATABASE_URL: connessione runtime (su Neon: endpoint pooled, adatto a serverless).
  url       = env("DATABASE_URL")
  // DIRECT_URL: connessione diretta (senza pooler) usata solo da Prisma Migrate.
  // In locale può coincidere con DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ClientType {
  ITALY
  EU
  EXTRA_EU
}

enum TaxRegime {
  FORFETTARIO
  ORDINARIO
  PRESTAZIONE_OCCASIONALE
}

enum InvoiceStatus {
  ISSUED
  PAID
  PARTIALLY_PAID
  CANCELLED
}

enum SenderType {
  LIBERO_PROFESSIONISTA
  DITTA_INDIVIDUALE
  SOCIETA
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  name          String
  passwordHash  String
  role          UserRole    @default(USER)
  
  businessName  String
  vatNumber     String
  taxCode       String
  address       String
  city          String
  zipCode       String
  country       String      @default("IT")
  province      String?
  taxRegime     TaxRegime   @default(FORFETTARIO)
  senderType    SenderType  @default(LIBERO_PROFESSIONISTA)

  // Sicurezza sessioni: incrementato a ogni cambio password (invalida i JWT precedenti).
  sessionVersion   Int      @default(0)
  // Autenticazione a due fattori (TOTP): secret cifrato, mai in chiaro nel DB.
  totpSecret       String?
  totpEnabled      Boolean  @default(false)
  totpBackupCodes  String[] @default([])

  // Zero-Knowledge Mode: se true, recovery solo via chiave utente (nessun fallback server)
  zeroKnowledgeEnabled      Boolean   @default(false)
  zeroKnowledgeActivatedAt  DateTime?

  // Doppio involucro per DEK utente (cifratura application-level).
  userKey          UserKey?

  clients       Client[]
  payments      Payment[]
  invoices      Invoice[]
  accounts      Account[]
  sessions      Session[]
  authTokens    AuthToken[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// Chiave di cifratura per utente (doppio involucro).
// W_pwd = DEK cifrata con chiave derivata da password utente (Argon2id).
// W_sys = DEK cifrata con Master Key di sistema (AES-256-GCM, chiave da env).
// DEK (Data Encryption Key) = chiave simmetrica AES-256 per cifrare i dati dell'utente.
model UserKey {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Salt per Argon2id (derivazione chiave da password).
  argon2Salt  String   // base64, 16 byte
  
  // W_pwd: DEK cifrata con chiave derivata da password (Argon2id -> AES-GCM).
  // Formato: base64(IV || ciphertext || authTag) — IV 12 byte, tag 16 byte.
  wPwd      String   // wrapped DEK with password-derived key
  
  // W_sys: DEK cifrata con Master Key di sistema (AES-GCM).
  // Formato: base64(IV || ciphertext || authTag).
  // In modalità Zero-Knowledge: DEK cifrata con chiave derivata da secret utente.
  wSys      String   // wrapped DEK with system master key (o ZK secret)
  
  // Zero-Knowledge Mode: se true, wSys contiene DEK avvolta con chiave utente
  zeroKnowledgeMode Boolean @default(false)
  // Salt per derivazione chiave ZK (base64, 16 byte)
  zkSalt      String?
  
  // Versione dello schema di cifratura (per future rotazioni/algoritmi).
  version   Int      @default(1)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Token monouso per setup account e reset password/2FA via email.
// Nel DB vive solo l'hash SHA-256: il token in chiaro viaggia solo nell'email.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    // 'setup' | 'password_reset' | 'mfa_reset'
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Client {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Campi sensibili cifrati: ciphertext (base64) + IV (base64) separati.
  // name, vatNumber, taxCode, sdiCode, address, city, zipCode, country
  nameEnc        String
  nameIv         String
  type           ClientType  @default(EXTRA_EU)  // non sensibile, in chiaro
  vatNumberEnc   String?
  vatNumberIv    String?
  taxCodeEnc     String?
  taxCodeIv      String?
  sdiCodeEnc     String?
  sdiCodeIv      String?
  addressEnc     String?
  addressIv      String?
  cityEnc        String?
  cityIv         String?
  zipCodeEnc     String?
  zipCodeIv      String?
  countryEnc     String?
  countryIv      String?
  
  payments    Payment[]
  invoices    Invoice[]
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
}

model Payment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id])
  
  // Campi sensibili cifrati
  amountEnc           String
  amountIv            String
  currencyEnc         String
  currencyIv          String
  originalAmountEnc   String?
  originalAmountIv    String?
  originalCurrencyEnc String?
  originalCurrencyIv  String?
  paidAtEnc           String
  paidAtIv            String
  descriptionEnc      String
  descriptionIv       String
  invoiceId           String?
  invoice             Invoice?  @relation(fields: [invoiceId], references: [id])
  
  createdAt   DateTime  @default(now())

  @@index([userId])
}

model Invoice {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Campi non sensibili (serve per query/ordinamento)
  number            Int
  year              Int
  dateEnc           String
  dateIv            String
  clientId          String
  client            Client        @relation(fields: [clientId], references: [id])
  payments          Payment[]
  items             InvoiceItem[]
  
  // Campi sensibili cifrati
  subtotalAmountEnc    String
  subtotalAmountIv     String
  stampDutyAmountEnc   String
  stampDutyAmountIv    String
  totalAmountEnc       String
  totalAmountIv        String
  notesEnc             String?
  notesIv              String?
  status               InvoiceStatus @default(ISSUED)  // non sensibile
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([userId, year, number])
  @@index([userId])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  // Campi sensibili cifrati
  descriptionEnc String
  descriptionIv  String
  amountEnc      String
  amountIv       String
}